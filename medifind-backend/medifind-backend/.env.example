# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# Where your frontend is served from, for CORS
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# A password for the admin panel (doctor verification, payouts).
# Pick your own long random string — you'll type this into the admin.html login screen.
ADMIN_TOKEN=change-this-to-another-long-random-string

# From your Stripe dashboard (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` (local dev) or your webhook endpoint settings (production)
STRIPE_WEBHOOK_SECRET=whsec_...

# What MediFind keeps from every appointment payment, as a decimal (0.12 = 12%)
PLATFORM_COMMISSION_RATE=0.12
